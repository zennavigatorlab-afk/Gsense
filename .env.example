# G-SENSE Environment Variables Template
# Copy this file to .env.local for local development.

# Application URL (Set by Vercel / hosting provider or localhost)
APP_URL="http://localhost:3000"

# Supabase Auth & Storage (Client-Safe Anonymous Key Only)
# Never expose the service_role key in frontend client bundles!
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Optional Server-Side Gemini API Key for extended contextual synthesis
# Note: Core G-SENSE pattern learning operates 100% locally on transparent rule metrics without external AI
GEMINI_API_KEY=""
